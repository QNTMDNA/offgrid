# --- Core -------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/offgrid?schema=public"
APP_URL="http://localhost:3000"
# Extra hosts allowed to submit Server Actions, comma separated. Required when
# the app is served behind a proxy or preview domain (APP_URL is always allowed).
SERVER_ACTION_ORIGINS=""
# 32+ char secret used to sign admin session cookies.
SESSION_SECRET="change-me-to-a-long-random-string"
# Shared secret required by /api/jobs/* so cron can drain the outbox.
JOB_TOKEN="change-me"

# --- Salesforce Sales Cloud --------------------------------------------------
# OAuth 2.0 client credentials flow against a Connected App with a run-as user.
SALESFORCE_ENABLED="false"
SALESFORCE_LOGIN_URL="https://login.salesforce.com"
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
SALESFORCE_API_VERSION="v62.0"

# --- Wise Business API -------------------------------------------------------
# Sandbox: https://api.sandbox.transferwise.tech
WISE_ENABLED="false"
WISE_API_URL="https://api.sandbox.transferwise.tech"
WISE_API_TOKEN=""
WISE_PROFILE_ID=""
# PEM private key registered with Wise, required to approve transfers under SCA.
WISE_SCA_PRIVATE_KEY=""
# Public key Wise signs webhook deliveries with.
WISE_WEBHOOK_PUBLIC_KEY=""

# --- Speakeasy ---------------------------------------------------------------
# Partner-issued credentials. Leave disabled to use the in-repo mock adapter.
SPEAKEASY_ENABLED="false"
SPEAKEASY_API_URL="https://api.speakeasygo.com"
SPEAKEASY_API_KEY=""
SPEAKEASY_VENUE_ID=""
SPEAKEASY_WEBHOOK_SECRET=""

# --- Email -------------------------------------------------------------------
# Leave unset to log campaign sends to stdout instead of delivering them.
RESEND_API_KEY=""
EMAIL_FROM="Off Grid <info@offgridrace.com>"

# Investor room: where uploaded decks are written. Must be a persistent volume
# in production; object storage needs a new driver in src/lib/investors/storage.ts.
INVESTOR_STORAGE_DIR="./storage/investors"
